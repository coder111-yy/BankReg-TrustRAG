# Local data paths
BANKREG_DATA_DIR=./03-金融大模型与智能体赛道-南京银行-面向银行业监管制度与统计报表的可信RAG问答
BANKREG_ARTIFACT_DIR=./artifacts
BANKREG_DB=./artifacts/bankreg.sqlite3
BANKREG_TOP_K=8
BANKREG_MIN_TRUST=0.58

# Local BGE retrieval/reranking. Use "required" after the models are present;
# "auto" records an explicit fallback when the optional ML runtime is missing.
BANKREG_BGE_MODE=required
BANKREG_BGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
BANKREG_BGE_RERANKER_MODEL=BAAI/bge-reranker-base
BANKREG_BGE_CACHE_DIR=./artifacts/models
BANKREG_BGE_VECTOR_DIR=./artifacts/bge_vectors
BANKREG_BGE_DEVICE=cpu
BANKREG_BGE_BATCH_SIZE=32
BANKREG_BGE_MAX_LENGTH=512
BANKREG_BGE_LOCAL_FILES_ONLY=1
BANKREG_BGE_RERANK_TOP_K=32

# Optional generation provider. The local deterministic answerer works without it.
# Set a local or authorized OpenAI-compatible endpoint to enable grounded LLM generation.
BANKREG_LLM_PROVIDER=none
BANKREG_LLM_MODEL=
BANKREG_LLM_BASE_URL=
BANKREG_LLM_API_KEY=
BANKREG_LLM_TIMEOUT_SECONDS=45
BANKREG_LLM_MAX_TOKENS=800
BANKREG_LLM_TEMPERATURE=0
BANKREG_LLM_MAX_CONTEXT_CHARS=12000
